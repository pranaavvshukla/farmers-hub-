
SECRET_KEY=replace-this-with-a-long-random-secret
JWT_SECRET_KEY=replace-this-with-another-long-random-secret
DATABASE_URL=sqlite:///farmhub.db
FRONTEND_URL=http://localhost:5173

# Platform fee (percent) deducted from each completed sale before the farmer payout
PLATFORM_FEE_PERCENT=2
# Optional: free API key from https://data.gov.in for live AGMARKNET mandi prices.
# Leave empty to use the offline cache in mandi_rates.json.
DATA_GOV_API_KEY=
# Village pool is "ready for a truck" at this many kg
POOL_TRUCK_KG=5000
# Optional: Razorpay TEST keys (Dashboard → Account & Settings → API Keys, in Test Mode).
# With these set, buyers pay through the real Razorpay checkout (test cards / test UPI).
# Leave empty to use the simulated UPI escrow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
